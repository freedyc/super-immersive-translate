{
  "manifest_version": 3,
  "name": "Super Immersive Translate - 超级翻译",
  "version": "2.1.0",
  "description": "超级沉浸式双语翻译插件，多引擎并行划词翻译 + 全页双语对照",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "contextMenus",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "side_panel": {
    "default_path": "sandbox/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "utils/translator.js",
        "utils/tts.js",
        "content/selection.js",
        "content/content.js",
        "content/input-translate.js",
        "content/subtitle.js",
        "content/clipboard.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-translate": {
      "suggested_key": {
        "default": "Alt+T",
        "mac": "Alt+T"
      },
      "description": "切换全页翻译"
    },
    "translate-selection": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "翻译选中文字"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "wordbook/*",
        "history/*",
        "pdf/*",
        "options/*",
        "sandbox/*",
        "icons/trigger.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
